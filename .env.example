# Copy to .env.local and fill in. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser — never put secrets in them.

# --- Site (Phase 1) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Phase 5) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=            # server only

# --- AI demo (Phase 4) — free-tier provider, see docs/ai-architecture.md ---
# AI_PROVIDER=gemini
# AI_MODEL=
# GEMINI_API_KEY=                 # server only
# AI_DEMO_MAX_PER_IP_PER_HOUR=5
# AI_DEMO_MAX_PER_DAY=200
# IP_HASH_SALT=                   # server only, long random string

# --- Lead notifications (Phase 5) ---

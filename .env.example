# Copy to .env.local and fill in. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser — never put secrets in them.

# --- Site (Phase 1) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Phase 5) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=            # server only

# --- AI demo (Phase 4) ---
# Works without these: the demo serves its prepared examples and shows "live AI is offline".
# Free key: https://aistudio.google.com → Get API key. Do NOT attach billing (keeps it free).
AI_PROVIDER=gemini
# Any free-tier Gemini model listed in AI Studio
AI_MODEL=gemini-2.5-flash-lite
# Server only
GEMINI_API_KEY=
AI_DEMO_MAX_PER_IP_PER_HOUR=5
AI_DEMO_MAX_PER_DAY=200
# Server only; long random string, e.g. from: openssl rand -hex 24
IP_HASH_SALT=

# --- Lead notifications (Phase 5) ---
# RESEND_API_KEY=                 # server only
# LEAD_NOTIFICATION_EMAIL=
# EMAIL_FROM=

# Copy to .env.local and fill in. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser — never put secrets in them.

# --- Site (Phase 1) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Phase 5) ---
# Local: run `npm run db:start`, then copy API_URL / PUBLISHABLE_KEY / SECRET_KEY from
# `npx supabase status`. Production: Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS; never expose it to the browser.
SUPABASE_SECRET_KEY=
CONTACT_MAX_PER_IP_PER_HOUR=5

# --- AI demo (Phase 4) ---
# Works without these: the demo serves its prepared examples and shows "live AI is offline".
# Free key: https://aistudio.google.com → Get API key. Do NOT attach billing (keeps it free).
AI_PROVIDER=gemini
# Any free-tier Gemini model listed in AI Studio
AI_MODEL=gemini-3.5-flash-lite
# Server only
GEMINI_API_KEY=
AI_DEMO_MAX_PER_IP_PER_HOUR=5
AI_DEMO_MAX_PER_DAY=200
# Server only; long random string, e.g. from: openssl rand -hex 24
IP_HASH_SALT=

# --- Lead notifications (Phase 5) ---
# Free Resend account: https://resend.com → API Keys. Without a verified domain, Resend only
# delivers to your own account email, sent from onboarding@resend.dev (fine to start).
# Server only
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
EMAIL_FROM=Mithila Web Labs <onboarding@resend.dev>
